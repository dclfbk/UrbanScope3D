# Repo root .gitignore - vedi anche web/.gitignore per il sottoprogetto Next.js

# Output intermedio della pipeline (vedi documentation/2_data-packaging-strategy.md)
/data/

# Output processati: i derivati leggeri (wind overlay, building heights, ...)
# vanno committati cosi' che il deploy su GitHub Pages li possa servire.
# Se un output futuro supera ~50 MB aggiungere qui un ignore mirato.

# Raw DBTR troppo grossi per GitHub (limite 100 MB / file).
# Si scaricano localmente con `python scripts/download_missing_data.py`.
/web/public/data/1)Buildings/1.2_DBTR_Edificio.json
/web/public/data/1)Buildings/1.3_DBTR_Unita_Volumetrica.json

# Estrazioni procons DBTR (stessi dati formato diverso, > 100 MB)
/web/public/data/2)Vegetation/2.4.2_estraz_procons.json

# Land Use raw shapefile per CRS (non usate dal viewer, alcune > 100 MB).
# Il viewer carica solo 4.1_uso_suolo_2020_ed2023_aoi.geojson (clippato all'AOI).
/web/public/data/4)LandUse-GroundSurface/4.1_Uso_Suolo_Dettaglio_2020_ETRS89/
/web/public/data/4)LandUse-GroundSurface/4.2_Uso_Suolo_Dettaglio_2020_GBO/
/web/public/data/4)LandUse-GroundSurface/4.3_Uso_Suolo_Dettaglio_2020_UTMRER/
/web/public/data/4)LandUse-GroundSurface/4.4_Uso_Suolo_Dettaglio_2020_RDN32/

# DSM raw (~500 .ASC) condiviso da Leonardo - serve solo come sorgente per
# scripts/build_dsm_ndsm.sh, l'output utile sta in processed/.
/web/public/data/DatiLeonardo_8-05-2026/
/web/public/data/wetransfer_dsm_bologna_2026-05-08_1237.zip

# Raster Envimet grezzi (~372 MB, 38 GeoTIFF multibanda) condivisi da
# Leonardo. Da agosto 2026 il sito li decodifica NEL BROWSER (lib/envimetTif):
# i sorgenti restano fuori da git (si recuperano dal drive del prof), online
# vanno solo i 12 marcati `shipped: true` nel registry, committati in docs/
# (vedi whitelist sotto).
/web/public/data/Envimet_data/

# Stessi grezzi, ma finiscono anche nel build statico docs/ (Next copia TUTTO
# web/public/ in out/). L'app non li serve: escludili anche da docs/ così il
# commit per GitHub Pages resta leggero (altrimenti docs/ pesa ~11 GB).
/docs/data/1)Buildings/1.2_DBTR_Edificio.json
/docs/data/1)Buildings/1.3_DBTR_Unita_Volumetrica.json
/docs/data/2)Vegetation/2.4.2_estraz_procons.json
/docs/data/4)LandUse-GroundSurface/4.1_Uso_Suolo_Dettaglio_2020_ETRS89/
/docs/data/4)LandUse-GroundSurface/4.2_Uso_Suolo_Dettaglio_2020_GBO/
/docs/data/4)LandUse-GroundSurface/4.3_Uso_Suolo_Dettaglio_2020_UTMRER/
/docs/data/4)LandUse-GroundSurface/4.4_Uso_Suolo_Dettaglio_2020_RDN32/
/docs/data/DatiLeonardo_8-05-2026/
/docs/data/wetransfer_dsm_bologna_2026-05-08_1237.zip
# Envimet in docs/: ignora tutto TRANNE i 12 tif `shipped: true` del registry
# (web/lib/envimetRegistry.ts) che il sito pubblicato scarica a runtime.
/docs/data/Envimet_data/*
!/docs/data/Envimet_data/00_objects_all_z.tif
!/docs/data/Envimet_data/01_flow_u_all_z.tif
!/docs/data/Envimet_data/02_flow_v_all_z.tif
!/docs/data/Envimet_data/03_flow_w_all_z.tif
!/docs/data/Envimet_data/04_wind_speed_all_z.tif
!/docs/data/Envimet_data/08_potential_air_temperature_all_z.tif
!/docs/data/Envimet_data/12_relative_humidity_all_z.tif
!/docs/data/Envimet_data/17_vegetation_lad_all_z.tif
!/docs/data/Envimet_data/18_direct_sw_radiation_all_z.tif
!/docs/data/Envimet_data/19_diffuse_sw_radiation_all_z.tif
!/docs/data/Envimet_data/20_reflected_sw_radiation_all_z.tif
!/docs/data/Envimet_data/26_mean_radiant_temp_all_z.tif

# wind_uv.values.json: derivato storico del microclima vivo (ora il vento
# viene dai cubi tif client-side). Resta su disco come materiale di tesi ma
# non va versionato ne' pubblicato.
/web/public/data/processed/envimet/wind_uv.values.json
/docs/data/processed/envimet/wind_uv.values.json

# Claude Code: locale (permessi) ignorato, ma i comandi slash di progetto
# (.claude/commands/) si versionano perche' codificano i flussi del repo
.claude/*
!.claude/commands/

# Riferimenti visivi personali per il 3D (video + appunti), non per il repo
/materialePer3D/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editor
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db
.vercel
.env*.local

# Backup locali dei geojson processati (rigenerabili dagli script)
*.bak
